<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="180.0" prefWidth="320.0" spacing="12.0" style="-fx-background-color: lightblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="umu.tds.vista.ControladorAñadirParticipante">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label alignment="TOP_CENTER" text="Participante">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <HBox spacing="10.0">
         <children>
            <Label prefHeight="27.0" prefWidth="47.0" text="Nombre" />
            <TextField fx:id="nombreParticipante" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <Label prefWidth="56.0" text="Porcentaje" />
            <TextField fx:id="cantidadPorcentaje" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox prefHeight="25.0" prefWidth="291.0" spacing="20.0">
         <children>
            <Button fx:id="BotonañadirParticipante" mnemonicParsing="false" onAction="#añadirParticipante" prefHeight="25.0" prefWidth="70.0" style="-fx-background-color: gray; -fx-text-fill: white; -fx-font-weight: bold;" text="Añadir" />
            <Button fx:id="cancel" mnemonicParsing="false" onAction="#cancelarAñadirParticipante" prefHeight="25.0" prefWidth="72.0" style="-fx-background-color: lightgray; -fx-font-weight: bold;" text="Cancelar" />
            <Button fx:id="BotonTerminarAñadirParticipantes" mnemonicParsing="false" onAction="#TerminarAñadirParticipantes" prefHeight="25.0" prefWidth="74.0" style="-fx-background-color: gray; -fx-text-fill: white; -fx-font-weight: bold;" text="Terminar" />
         </children>
      </HBox>
   </children>
</VBox>
