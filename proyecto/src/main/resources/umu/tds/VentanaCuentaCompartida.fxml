<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: lightblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="umu.tds.vista.ControladorCuentaCompartida">
   <children>
      <VBox prefHeight="93.0" prefWidth="134.0">
         <children>
            <Label alignment="TOP_CENTER" prefHeight="47.0" prefWidth="135.0" style="-fx-font-weight: bold;" text="CUENTA " textAlignment="CENTER">
               <padding>
                  <Insets top="30.0" />
               </padding>
            </Label>
            <Label alignment="TOP_CENTER" prefHeight="17.0" prefWidth="138.0" style="-fx-font-weight: bold;" text="COMPARTIDA" />
         </children>
      </VBox>
      <HBox layoutX="134.0" layoutY="28.0" prefHeight="79.0" prefWidth="467.0">
         <children>
            <VBox prefHeight="79.0" prefWidth="120.0">
               <children>
                  <Label prefHeight="33.0" prefWidth="111.0" text="Añadir Participantes" />
               </children>
            </VBox>
            <VBox prefHeight="79.0" prefWidth="117.0">
               <children>
                  <Button fx:id="BotonAddParticipantes" mnemonicParsing="false" onAction="#addParticipantes" text="+AddParticipante" />
               </children>
               <padding>
                  <Insets top="5.0" />
               </padding>
            </VBox>
            <VBox prefHeight="79.0" prefWidth="237.0">
               <children>
                  <CheckBox fx:id="BotonAsignarDefecto" mnemonicParsing="false" onAction="#asignarDefecto" prefHeight="36.0" prefWidth="152.0" selected="true" text="Asignar por defecto" />
               </children>
               <padding>
                  <Insets left="50.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
      <TableView fx:id="tablaCuentaCompartida" layoutX="134.0" layoutY="141.0" prefHeight="300.0" prefWidth="600.0">
        <columns>
          <TableColumn fx:id="NombrePersonaTabla" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="TotalPersonaTabla" prefWidth="75.0" text="Total" />
          <TableColumn fx:id="PorcentajePersonaTabla" prefWidth="75.0" text="Porcentaje" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox layoutX="134.0" layoutY="77.0" prefHeight="86.0" prefWidth="442.0">
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="AñadirGasto" />
               </children>
               <padding>
                  <Insets left="15.0" top="25.0" />
               </padding>
            </VBox>
            <VBox prefHeight="86.0" prefWidth="87.0">
               <children>
                  <Button fx:id="BotonAddGasto" mnemonicParsing="false" onAction="#addGasto" text="+AddGasto" />
               </children>
               <padding>
                  <Insets top="20.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
      <VBox layoutX="8.0" layoutY="97.0" prefHeight="178.0" prefWidth="118.0" spacing="10.0">
         <children>
            <Label text="Cuenta:" />
            <ComboBox fx:id="selectorCuentas" onAction="#cambiarCuenta" prefWidth="150.0" />
            <Button fx:id="botonNuevaCuenta" alignment="CENTER" mnemonicParsing="false" onAction="#crearCuenta" text="+Cuenta" />
         </children>
      </VBox>
   </children>
</AnchorPane>
